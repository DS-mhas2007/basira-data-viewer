# Server-only AI provider secrets. Never use VITE_ prefixes for these keys.
# Configure the dedicated MIZYAi Cloudflare Worker first; external providers are optional fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional provider order; unknown or absent entries use the task defaults.
# AI_PROVIDER_ORDER=groq,gemini,mizyai_worker,cloudflare,openrouter
# Timeout per provider in milliseconds; individual PROVIDER_TIMEOUT_MS overrides it.
# AI_PROVIDER_TIMEOUT_MS=15000
# GROQ_TIMEOUT_MS=10000
# Avoid queueing behind a saturated provider; per-provider values override the global value.
# AI_PROVIDER_MAX_CONCURRENCY=4
# GROQ_MAX_CONCURRENCY=4
# CLOUDFLARE_MAX_CONCURRENCY=8
# MIZYAI_WORKER_MAX_CONCURRENCY=8
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=openrouter/free
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it

# Dedicated MIZYAi Cloudflare Worker (server-only; URL without trailing slash)
MIZYAI_WORKER_URL=https://mizyai-ai-orchestrator.mhasplaygame.workers.dev
MIZYAI_WORKER_API_KEY=
MIZYAI_WORKER_MODEL=@cf/google/gemma-4-26b-a4b-it

# Optional task-specific overrides (server-only)
# GEMINI_CHAT_MODEL=
# GROQ_SQL_PLAN_MODEL=
# GROQ_CHAT_MODEL=
# CLOUDFLARE_DISCOVERY_MODEL=
# OPENROUTER_REPORT_MODEL=

# Supabase server configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-accessible public configuration only
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=

# Optional CORS allow-list for server functions (comma-separated)
SUPABASE_FUNCTIONS_ALLOWED_ORIGINS=
