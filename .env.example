# Server-only AI provider secrets. Never use VITE_ prefixes for these keys.
# Configure the dedicated MIZYAi Cloudflare Worker first; external providers are optional fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=openrouter/free
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it

# Dedicated MIZYAi Cloudflare Worker (server-only; URL without trailing slash)
MIZYAI_WORKER_URL=https://mizyai-ai-orchestrator.mhasplaygame.workers.dev
MIZYAI_WORKER_API_KEY=
MIZYAI_WORKER_MODEL=cloudflare-workers-ai

# Optional task-specific overrides (server-only)
# GEMINI_CHAT_MODEL=
# GROQ_SQL_PLAN_MODEL=
# OPENROUTER_REPORT_MODEL=

# Supabase server configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-accessible public configuration only
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=

# Optional CORS allow-list for server functions (comma-separated)
SUPABASE_FUNCTIONS_ALLOWED_ORIGINS=
