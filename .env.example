# Server-only secrets (DO NOT expose in the client)
OPENROUTER_API_KEY=
OPENROUTER_API_BASE= # optional, defaults to https://openrouter.ai/api/v1/chat/completions
SUPABASE_SERVICE_ROLE_KEY=

# CORS / functions allowed origins (comma-separated). Use "*" to allow all (not recommended for prod)
SUPABASE_FUNCTIONS_ALLOWED_ORIGINS=*

# Client-accessible (Vite): these MUST start with VITE_ to be embedded in the client build
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_PROXY_URL= # e.g. https://your-project.vercel.app/api/openrouter-proxy  OR leave empty to call server-side createServerFn
VITE_SITE_URL= # e.g. https://your-project.vercel.app

# Optional: other third-party keys formerly used by Lovable
# VITE_LOVABLE_CLIENT_ID=
# VITE_LOVABLE_AUTH_URL=
