# Server-only AI provider secrets. Never use VITE_ prefixes for these keys.
# Add one or more providers. The orchestrator prefers Gemini -> Groq -> OpenRouter -> Cloudflare.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=google/gemma-4-31b-it:free
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Optional task-specific overrides (server-only)
# GEMINI_CHAT_MODEL=
# GROQ_SQL_PLAN_MODEL=
# OPENROUTER_REPORT_MODEL=

# Supabase server configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-accessible public configuration only
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=

# Optional CORS allow-list for server functions (comma-separated)
SUPABASE_FUNCTIONS_ALLOWED_ORIGINS=
